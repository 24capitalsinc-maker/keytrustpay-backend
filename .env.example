# =================================================================
# KEYTRUST PAY - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# =================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database
# Required: MongoDB Atlas cluster URI (Must support replica set for Mongoose transactions)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/banking_db?retryWrites=true&w=majority

# JWT Authentication
# Generate 256-bit random hex strings for production
JWT_SECRET=your_jwt_access_secret_key_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_here

# Frontend Application URL
# In local dev: http://localhost:3000
# In production on Vercel: https://keytrustpay.org or https://<your-project>.vercel.app
FRONTEND_URL=http://localhost:3000

# Operations & Administrator Email Alert Recipient
ADMIN_EMAIL=admin@keytrustpay.org

# SMTP Configuration (Nodemailer)
# Hostname for outgoing mail server
SMTP_HOST=mail.keytrustpay.org
# Port 465 (SSL/TLS) or 587 (STARTTLS)
SMTP_PORT=465
# Authorized mailbox credentials
SMTP_USER=support@keytrustpay.org
SMTP_PASS=your_smtp_password_here

# Optional: Resend API Key
RESEND_API_KEY=re_your_api_key
